#!/usr/bin/env python3
"""Git credential helper маркетплейса.

Git вызывает его как `git-credential-mp get` и ждёт на stdout username/password.
Пароль — временный git-токен (1 репозиторий, 1 час), который выдаёт бэкенд:
POST {api_base}/projects/{project_id}/git-token.

Используется только когда адрес репозитория получен через API (см. mp init).
"""
import json
import os
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return  # store / erase не нужны: токен короткоживущий
    sys.stdin.read()  # git передаёт protocol/host/path — нам они не нужны
    cfg = json.loads((ROOT / ".marketplace" / "project.json").read_text(encoding="utf-8"))
    token = os.environ.get("MP_TOKEN")
    if not token:
        for line in (ROOT / ".env").read_text(encoding="utf-8").splitlines():
            if line.strip().startswith("MP_TOKEN="):
                token = line.split("=", 1)[1].strip()
    req = urllib.request.Request(
        f"{cfg['api_base'].rstrip('/')}/projects/{cfg['project_id']}/git-token",
        method="POST", headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, timeout=15) as r:
        cred = json.load(r)
    sys.stdout.write(f"username={cred['username']}\npassword={cred['password']}\n")


if __name__ == "__main__":
    main()
